---
import Base from '../../layouts/Base.astro';
import projets from '../../data/projets.json';
import { u } from '../../utils.js';
---
<Base titre="Projets">
  <h1>Projets</h1>
  <div class="grid">
    {projets.map((p) => (
      <article class="carte">
        <h2><a href={u(`projets/${p.slug}/`)}>{p.titre}</a></h2>
        <p class="meta">{p.type}</p>
        <p>{p.besoin}</p>
      </article>
    ))}
  </div>
</Base>
