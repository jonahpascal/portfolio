---
import Base from '../../layouts/Base.astro';
import competences from '../../data/competences.json';
import projets from '../../data/projets.json';
import { u } from '../../utils.js';
---
<Base titre="Compétences">
  <h1>Compétences</h1>
  <p class="lead">Ce que je sais faire, comment j'ai progressé, et les projets qui le prouvent.</p>
  <div class="grid">
    {competences.map((c) => (
      <a class="carte" href={u(`competences/${c.slug}/`)} style={`--c:${c.couleur}`}>
        <h2>{c.nom}</h2>
        <p>{c.resume}</p>
        <p class="meta">{projets.filter((p) => p.competences.includes(c.slug)).length} projet(s) à voir</p>
      </a>
    ))}
  </div>
</Base>
