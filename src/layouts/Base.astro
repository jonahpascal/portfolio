---
import '../styles/global.css';
import { u } from '../utils.js';
const { titre = 'Portfolio' } = Astro.props;
const path = Astro.url.pathname;
const liens = [['Accueil', ''], ['Compétences', 'competences/'], ['Projets', 'projets/'], ['CV', 'cv/'], ['Contact', 'contact/']];
const actif = (h) => (h === '' ? path.replace(/\/$/, '') === u().replace(/\/$/, '') : path.startsWith(u(h)));
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titre} – Prénom Nom</title>
  <script is:inline>
    try { var t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header id="top">
    <nav class="wrap">
      <a class="nom" href={u()}><span class="logo" aria-hidden="true">PN</span>Prénom Nom</a>
      <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false">Menu</button>
      <ul id="menu">
        <span class="pill" aria-hidden="true"></span>
        {liens.map(([t, h]) => <li><a href={u(h)} aria-current={actif(h) ? 'page' : undefined}>{t}</a></li>)}
        <li><button id="theme" aria-label="Changer de thème">☾</button></li>
      </ul>
    </nav>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="wrap">© Prénom Nom · <a href="https://github.com/VOTRE-PSEUDO">GitHub</a></footer>
  <script>
    const header = document.getElementById('top');
    const b = document.querySelector('.burger'), m = document.getElementById('menu');
    b.addEventListener('click', () => { const o = m.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });

    const th = document.getElementById('theme');
    const icone = () => { th.textContent = document.documentElement.dataset.theme === 'dark' ? '☀' : '☾'; };
    icone();
    th.addEventListener('click', () => {
      const n = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = n;
      try { localStorage.setItem('theme', n); } catch (e) {}
      icone();
    });

    // Pastille qui glisse sous le lien survolé, puis revient sur la page active
    const pill = m.querySelector('.pill');
    const liens = [...m.querySelectorAll('li > a')];
    const actif = m.querySelector('a[aria-current=page]');
    const place = (a, anim = true) => {
      if (!a) { pill.style.opacity = 0; return; }
      pill.style.transition = anim ? '' : 'none';
      pill.style.opacity = 1;
      pill.style.width = a.offsetWidth + 'px';
      pill.style.height = a.offsetHeight + 'px';
      pill.style.transform = `translate(${a.offsetLeft}px, ${a.offsetTop}px)`;
    };
    liens.forEach((a) => { a.addEventListener('mouseenter', () => place(a)); a.addEventListener('focus', () => place(a)); });
    m.addEventListener('mouseleave', () => place(actif));
    m.addEventListener('focusout', () => place(actif));
    const init = () => place(actif, false);
    init(); document.fonts?.ready.then(init); addEventListener('resize', init);

    // Barre réduite + progression de lecture
    const scroll = () => {
      const h = document.documentElement;
      header.classList.toggle('scrolled', scrollY > 24);
      header.style.setProperty('--p', String(h.scrollHeight - innerHeight > 0 ? scrollY / (h.scrollHeight - innerHeight) : 0));
    };
    addEventListener('scroll', scroll, { passive: true }); scroll();
  </script>
</body>
</html>
