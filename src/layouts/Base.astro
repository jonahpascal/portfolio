---
import '../styles/global.css';
import { u } from '../utils.js';
const { titre = 'Portfolio' } = Astro.props;
const path = Astro.url.pathname;
const liens = [['Accueil', ''], ['Compétences', 'competences/'], ['Projets', 'projets/'], ['CV', 'cv/'], ['Contact', 'contact/']];
const actif = (h) => (h === '' ? path === u() || path === u('') + '/' || path === u().replace(/\/$/, '') : path.startsWith(u(h)));
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titre} – Prénom Nom</title>
  <script is:inline>
    try { var t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header>
    <nav class="wrap">
      <a class="nom" href={u()}>Prénom Nom</a>
      <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false">Menu</button>
      <ul id="menu">
        {liens.map(([t, h]) => <li><a href={u(h)} aria-current={actif(h) ? 'page' : undefined}>{t}</a></li>)}
        <li><button id="theme" aria-label="Changer de thème">Thème</button></li>
      </ul>
    </nav>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="wrap">© Prénom Nom · <a href="https://github.com/VOTRE-PSEUDO">GitHub</a></footer>
  <script>
    const b = document.querySelector('.burger'), m = document.getElementById('menu');
    b.addEventListener('click', () => { const o = m.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
    document.getElementById('theme').addEventListener('click', () => {
      const n = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = n;
      try { localStorage.setItem('theme', n); } catch (e) {}
    });
  </script>
</body>
</html>
