---
import '../styles/global.css';
import { u } from '../utils.js';
const { titre = 'Portfolio' } = Astro.props;
const liens = [['Accueil', ''], ['Compétences', 'competences/'], ['Projets', 'projets/'], ['CV', 'cv/'], ['Contact', 'contact/']];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titre} – Prénom Nom</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <header>
    <nav class="wrap">
      <a class="nom" href={u()}>Prénom Nom</a>
      <ul>{liens.map(([t, h]) => <li><a href={u(h)}>{t}</a></li>)}</ul>
    </nav>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="wrap">© Prénom Nom · <a href="https://github.com/VOTRE-PSEUDO">GitHub</a></footer>
</body>
</html>
